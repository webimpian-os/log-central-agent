[Unit]
Description=Send PHP fatal errors from this server's sites to Log Central
Documentation=https://github.com/webimpian-os/log-central-agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=log-central-agent
Group=log-central-agent
ExecStart=/opt/log-central-agent/bin/vector --threads 2 --graceful-shutdown-limit-secs 10 --config /opt/log-central-agent/config/pipeline.yaml --config /opt/log-central-agent/config/panel.yaml --config /opt/log-central-agent/config/runtime.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StateDirectory=log-central-agent
StateDirectoryMode=0755

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

Nice=19
IOSchedulingClass=idle
CPUQuota=50%
# cgroup v1 servers also get MemoryLimit= from the installer.
MemoryMax=256M
# When the server runs out of memory, the kernel kills the agent before any site or database.
OOMScoreAdjust=1000
LimitNOFILE=65536
LogRateLimitIntervalSec=60s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
